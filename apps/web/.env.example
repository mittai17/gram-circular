# -----------------------------------------------------------------------------
# GRAM-CIRCULAR (ECOZA) - Web Application Environment Configuration
# -----------------------------------------------------------------------------

# Next.js Port (Default: 3000)
PORT=3000

# API Backend Gateway URL
NEXT_PUBLIC_API_URL="http://localhost:3001"

# -----------------------------------------------------------------------------
# Map & Geospatial Routing Configuration
# -----------------------------------------------------------------------------
# NOTE: OpenStreetMap (OSM) and OSRM are open-source and DO NOT require an API key!
# By default, public open community servers are used:
#
# 1. Map Tiles: OpenStreetMap public tiles
#    Default: https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_OSM_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
#
# 2. Road Routing Engine: OSRM (Open Source Routing Machine) public demo API
#    Default: https://router.project-osrm.org
# NEXT_PUBLIC_OSRM_ROUTING_URL="https://router.project-osrm.org"
#
# (Optional) If using a commercial tile provider or self-hosted tile server:
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=""
# NEXT_PUBLIC_GEOAPIFY_API_KEY=""
