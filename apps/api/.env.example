# -----------------------------------------------------------------------------
# GRAM-CIRCULAR (ECOZA) - Backend API Environment Configuration
# -----------------------------------------------------------------------------

# PostgreSQL / Neon Database Connection String
# e.g. postgresql://user:password@neon-host:5432/gram_circular?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/gram_circular"

# Backend API Port (Default: 3001)
PORT=3001

# Application Environment (development | production | test)
NODE_ENV=development

# Frontend Web Origin (for CORS configuration)
FRONTEND_URL="http://localhost:3000"

# JWT Secret for Stakeholder Authentication (optional/development fallback used)
JWT_SECRET="gram-circular-dev-super-secret-key-32-bytes"

# OR-Tools / Routing Engine Configuration (if connecting to external solver)
# OSRM_ROUTER_URL="https://router.project-osrm.org"
