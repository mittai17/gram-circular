generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Village {
  id          String   @id @default(uuid())
  name        String
  district    String
  taluk       String
  pincode     String
  latitude    Decimal  @db.Decimal(9, 6)
  longitude   Decimal  @db.Decimal(9, 6)
  population  Int
  wardCount   Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  collectionPoints CollectionPoint[]
  citizenReports   CitizenReport[]
  collectionSchedules CollectionSchedule[]

  @@map("villages")
}

model CollectionPoint {
  id          String   @id @default(uuid())
  villageId   String
  village     Village  @relation(fields: [villageId], references: [id])
  name        String
  address     String
  latitude    Decimal  @db.Decimal(9, 6)
  longitude   Decimal  @db.Decimal(9, 6)
  wasteStreams String[]
  isActive    Boolean  @default(true)
  lastCollectedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bins         Bin[]
  wasteBatches WasteBatch[]
  routeStops   RouteStop[]
  citizenReports CitizenReport[]
  pickupRequests PickupRequest[]

  @@map("collection_points")
}

model Bin {
  id                String   @id @default(uuid())
  collectionPointId String
  collectionPoint   CollectionPoint @relation(fields: [collectionPointId], references: [id])
  serialNumber      String   @unique
  wasteStream       String
  capacityLitres    Decimal  @db.Decimal(8, 2)
  fillLevel         String   @default("EMPTY")
  fillPercent       Int      @default(0)
  lastReadingAt     DateTime?
  sensorDeviceId    String?
  isActive          Boolean  @default(true)
  updatedAt         DateTime @updatedAt

  @@map("bins")
}

model Vehicle {
  id                 String   @id @default(uuid())
  registrationNumber String   @unique
  type               String
  capacityKg         Decimal  @db.Decimal(8, 2)
  currentLoadKg      Decimal  @db.Decimal(8, 2) @default(0)
  driverName         String
  driverPhone        String
  isAvailable        Boolean  @default(true)
  depotVillageId     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  routePlans RoutePlan[]
  dispatches Dispatch[]

  @@map("vehicles")
}

model WeighingDevice {
  id               String   @id @default(uuid())
  serialNumber     String   @unique
  location         String
  isOnline         Boolean  @default(false)
  lastPingAt       DateTime?
  calibratedAt     DateTime?
  isSimulated      Boolean  @default(false)
  createdAt        DateTime @default(now())

  readings         DeviceReading[]

  @@map("weighing_devices")
}

model DeviceReading {
  id               String   @id @default(uuid())
  deviceId         String
  device           WeighingDevice @relation(fields: [deviceId], references: [id])
  weightKg         Decimal  @db.Decimal(8, 3)
  isStable         Boolean
  source           String   // SENSOR | SIMULATED | MANUAL
  recordedAt       DateTime @default(now())

  @@map("device_readings")
}

model WasteBatch {
  id                String   @id @default(uuid())
  batchCode         String   @unique
  qrToken           String   @unique
  collectionPointId String
  collectionPoint   CollectionPoint @relation(fields: [collectionPointId], references: [id])
  wasteStream       String
  materialSubtype   String?
  grossWeightKg     Decimal  @db.Decimal(8, 3)
  tareWeightKg      Decimal  @db.Decimal(8, 3) @default(0)
  netWeightKg       Decimal  @db.Decimal(8, 3)
  weightSource      String
  status            String   @default("CREATED")
  workerName        String
  collectedAt       DateTime
  notes             String?
  photoUrl          String?
  deviceId          String?
  calibrationStatus String?
  clientOperationId String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  events           BatchEvent[]
  inspection       QualityInspection?
  inventoryMoves   InventoryMovement[]
  dispatchBatches  DispatchBatch[]

  @@index([status])
  @@index([collectionPointId])
  @@index([wasteStream, materialSubtype])
  @@map("waste_batches")
}

model BatchEvent {
  id          String   @id @default(uuid())
  batchId     String
  batch       WasteBatch @relation(fields: [batchId], references: [id])
  eventType   String
  fromStatus  String?
  toStatus    String
  performedBy String
  role        String
  notes       String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([batchId])
  @@map("batch_events")
}

model QualityInspection {
  id                  String   @id @default(uuid())
  batchId             String   @unique
  batch               WasteBatch @relation(fields: [batchId], references: [id])
  inspectorName       String
  contaminationLevel  String
  moistureLevel       String
  packagingCondition  String
  foreignMaterials    Boolean
  outcome             String
  grade               String
  notes               String?
  inspectedAt         DateTime @default(now())

  @@map("quality_inspections")
}

model StorageZone {
  id            String   @id @default(uuid())
  mrfId         String
  name          String
  wasteStream   String
  capacityKg    Decimal  @db.Decimal(10, 2)
  currentStockKg Decimal @db.Decimal(10, 2) @default(0)
  location      String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  inventoryMoves InventoryMovement[]

  @@map("storage_zones")
}

model InventoryMovement {
  id            String   @id @default(uuid())
  storageZoneId String
  storageZone   StorageZone @relation(fields: [storageZoneId], references: [id])
  batchId       String?
  batch         WasteBatch? @relation(fields: [batchId], references: [id])
  movementType  String   // IN | OUT | ADJUSTMENT
  weightKg      Decimal  @db.Decimal(8, 3)
  notes         String?
  performedBy   String
  createdAt     DateTime @default(now())

  @@index([storageZoneId])
  @@map("inventory_movements")
}

model Processor {
  id                   String   @id @default(uuid())
  name                 String
  contactName          String
  contactPhone         String
  address              String
  latitude             Decimal  @db.Decimal(9, 6)
  longitude            Decimal  @db.Decimal(9, 6)
  acceptedMaterials    String[]
  minQuantityKg        Decimal  @db.Decimal(8, 2)
  maxQuantityKg        Decimal  @db.Decimal(8, 2)
  indicativePricePerKg Decimal? @db.Decimal(8, 2)
  isDemo               Boolean  @default(true)
  isVerified           Boolean  @default(false)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())

  dispatches     Dispatch[]
  purchaseRequests PurchaseRequest[]

  @@map("processors")
}

model RoutePlan {
  id                   String   @id @default(uuid())
  vehicleId            String
  vehicle              Vehicle  @relation(fields: [vehicleId], references: [id])
  status               String   @default("PLANNED")
  plannedDate          DateTime
  estimatedDistanceKm  Decimal  @db.Decimal(8, 2) @default(0)
  estimatedDurationMin Int      @default(0)
  optimized            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  stops RouteStop[]

  @@map("route_plans")
}

model RouteStop {
  id                String   @id @default(uuid())
  routePlanId       String
  routePlan         RoutePlan @relation(fields: [routePlanId], references: [id])
  collectionPointId String
  collectionPoint   CollectionPoint @relation(fields: [collectionPointId], references: [id])
  sequence          Int
  estimatedArrival  DateTime?
  actualArrival     DateTime?
  status            String   @default("PENDING")
  collectedWeightKg Decimal? @db.Decimal(8, 3)

  @@map("route_stops")
}

model Dispatch {
  id           String   @id @default(uuid())
  dispatchCode String   @unique
  status       String   @default("DRAFT")
  processorId  String
  processor    Processor @relation(fields: [processorId], references: [id])
  vehicleId    String?
  vehicle      Vehicle? @relation(fields: [vehicleId], references: [id])
  totalWeightKg Decimal  @db.Decimal(10, 3)
  scheduledDate DateTime
  createdBy    String
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  batches          DispatchBatch[]
  receipts         Receipt[]
  processingEvidences ProcessingEvidence[]

  @@map("dispatches")
}

model DispatchBatch {
  id         String   @id @default(uuid())
  dispatchId String
  dispatch   Dispatch @relation(fields: [dispatchId], references: [id])
  batchId    String
  batch      WasteBatch @relation(fields: [batchId], references: [id])
  weightKg   Decimal  @db.Decimal(8, 3)
  createdAt  DateTime @default(now())

  @@unique([dispatchId, batchId])
  @@map("dispatch_batches")
}

model Receipt {
  id               String   @id @default(uuid())
  dispatchId       String
  dispatch         Dispatch @relation(fields: [dispatchId], references: [id])
  receivedBy       String
  receivedWeightKg Decimal  @db.Decimal(10, 3)
  discrepancyKg    Decimal  @db.Decimal(10, 3) @default(0)
  notes            String?
  evidenceUrl      String?
  receivedAt       DateTime @default(now())

  @@map("receipts")
}

model ProcessingEvidence {
  id                String   @id @default(uuid())
  dispatchId        String
  dispatch          Dispatch @relation(fields: [dispatchId], references: [id])
  processedWeightKg Decimal  @db.Decimal(10, 3)
  processType       String
  evidenceUrl       String?
  verifiedBy        String?
  notes             String?
  processedAt       DateTime
  createdAt         DateTime @default(now())

  @@map("processing_evidences")
}

model CitizenReport {
  id                String   @id @default(uuid())
  villageId         String
  village           Village  @relation(fields: [villageId], references: [id])
  collectionPointId String?
  collectionPoint   CollectionPoint? @relation(fields: [collectionPointId], references: [id])
  reportType        String
  description       String
  photoUrl          String?
  latitude          Decimal? @db.Decimal(9, 6)
  longitude         Decimal? @db.Decimal(9, 6)
  status            String   @default("PENDING")
  reportedBy        String
  createdAt         DateTime @default(now())
  resolvedAt        DateTime?

  @@map("citizen_reports")
}

model CollectionSchedule {
  id          String   @id @default(uuid())
  villageId   String
  village     Village  @relation(fields: [villageId], references: [id])
  wasteStream String
  dayOfWeek   Int      // 0=Sun, 6=Sat
  timeSlot    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("collection_schedules")
}

model SyncOperation {
  id                String   @id @default(uuid())
  clientOperationId String   @unique
  operationType     String
  payload           Json
  state             String   @default("PENDING")
  retryCount        Int      @default(0)
  lastError         String?
  createdAt         DateTime @default(now())
  syncedAt          DateTime?

  @@index([state])
  @@map("sync_operations")
}

model AnomalyFlag {
  id          String   @id @default(uuid())
  anomalyType String
  entityId    String?
  entityType  String?
  description String
  severity    String   @default("MEDIUM")
  isResolved  Boolean  @default(false)
  resolvedBy  String?
  resolvedAt  DateTime?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@map("anomaly_flags")
}

model PurchaseRequest {
  id          String   @id @default(uuid())
  processorId String
  processor   Processor @relation(fields: [processorId], references: [id])
  status      String   @default("PENDING")
  requestedWeightKg Decimal @db.Decimal(10, 2)
  materialType String
  minGrade    String
  offeredPricePerKg Decimal? @db.Decimal(8, 2)
  notes       String?
  requestedBy String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("purchase_requests")
}

model SimulationRun {
  id          String   @id @default(uuid())
  name        String
  scenario    String
  parameters  Json
  results     Json?
  status      String   @default("PENDING")
  createdBy   String
  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@map("simulation_runs")
}

model AuditEvent {
  id          String   @id @default(uuid())
  entityType  String
  entityId    String
  action      String
  performedBy String
  role        String
  before      Json?
  after       Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_events")
}

model RewardTransaction {
  id            String   @id @default(uuid())
  citizenName   String
  villageId     String
  points        Int
  reason        String
  referenceId   String?
  createdAt     DateTime @default(now())

  @@map("reward_transactions")
}

model PoolingGroup {
  id              String   @id @default(uuid())
  name            String
  status          String   @default("DRAFT")
  targetProcessorId String?
  totalWeightKg   Decimal  @db.Decimal(10, 2) @default(0)
  estimatedSavingsINR Decimal? @db.Decimal(10, 2)
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("pooling_groups")
}

// ─── MLP Construction Upcycling ─────────────────────────────────────

model ProductionRun {
  id              String   @id @default(uuid())
  runCode         String   @unique
  mrfId           String
  productType     String   // PAVER_BLOCK | FENCING_POST | ROOF_SHEET | ROAD_ADDITIVE | AGGLOMERATE
  status          String   @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED | FAILED

  // Inputs
  mlpInputKg      Decimal  @db.Decimal(10, 3)
  sandInputKg     Decimal? @db.Decimal(10, 3)
  binderInputKg   Decimal? @db.Decimal(10, 3)
  otherInputKg    Decimal? @db.Decimal(10, 3)

  // Outputs
  outputQuantity  Int      @default(0)
  outputUnit      String   // UNITS | KG
  outputWeightKg  Decimal? @db.Decimal(10, 3)
  yieldRatioPercent Decimal? @db.Decimal(5, 2)

  // Quality
  grade           String?  // A | B | C
  qualityPassedAt DateTime?
  compressiveStrengthMpa Decimal? @db.Decimal(6, 2)
  waterAbsorptionPercent Decimal? @db.Decimal(5, 2)
  qualityNotes    String?

  // Traceability
  operatorName    String
  machineId       String?
  energyKwh       Decimal? @db.Decimal(8, 3)
  wasteLossKg     Decimal? @db.Decimal(8, 3)
  notes           String?
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  batchInputs     ProductionBatchInput[]
  saleLineItems   SaleLineItem[]

  @@index([status])
  @@index([productType])
  @@map("production_runs")
}

model ProductionBatchInput {
  id              String   @id @default(uuid())
  productionRunId String
  productionRun   ProductionRun @relation(fields: [productionRunId], references: [id])
  wasteBatchId    String
  weightUsedKg    Decimal  @db.Decimal(8, 3)
  createdAt       DateTime @default(now())

  @@map("production_batch_inputs")
}

// ─── Demand-Driven Dynamic Routing ────────────────────────────────────

model PickupRequest {
  id                String   @id @default(uuid())
  collectionPointId String
  collectionPoint   CollectionPoint @relation(fields: [collectionPointId], references: [id])
  requestedBy       String
  requestType       String   @default("OVERFLOW") // OVERFLOW | SCHEDULED | ON_DEMAND
  estimatedWeightKg Decimal? @db.Decimal(8, 2)
  fillLevelPercent  Int?
  urgency           String   @default("NORMAL") // LOW | NORMAL | HIGH | CRITICAL
  status            String   @default("PENDING") // PENDING | ASSIGNED | COMPLETED | CANCELLED
  notes             String?
  routePlanId       String?
  assignedAt        DateTime?
  completedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
  @@map("pickup_requests")
}

model RouteOptimizationLog {
  id                    String   @id @default(uuid())
  routePlanId           String?
  triggeredBy           String   // THRESHOLD | MANUAL | SCHEDULED | ON_DEMAND
  baselineDistanceKm    Decimal  @db.Decimal(8, 2)
  optimizedDistanceKm   Decimal  @db.Decimal(8, 2)
  distanceSavedKm       Decimal  @db.Decimal(8, 2)
  fuelSavedLitres       Decimal? @db.Decimal(8, 2)
  fuelSavedINR          Decimal? @db.Decimal(10, 2)
  co2SavedKg            Decimal? @db.Decimal(8, 3)
  stopsCount            Int
  algorithm             String   @default("GLS_CVRP")
  solverDurationMs      Int?
  createdAt             DateTime @default(now())

  @@map("route_optimization_logs")
}

// ─── PWMU O&M Financial Sustainability ────────────────────────────────

model OperationalExpense {
  id           String   @id @default(uuid())
  mrfId        String
  category     String   // LABOR | FUEL | ELECTRICITY | MAINTENANCE | CONSUMABLES | OTHER
  description  String
  amountINR    Decimal  @db.Decimal(12, 2)
  quantity     Decimal? @db.Decimal(10, 3)
  unit         String?  // LITRE | KWH | DAY | UNIT
  periodDate   DateTime
  recordedBy   String
  createdAt    DateTime @default(now())

  @@index([category])
  @@index([periodDate])
  @@map("operational_expenses")
}

model RevenueEntry {
  id           String   @id @default(uuid())
  mrfId        String
  source       String   // RECYCLER_SALE | UPCYCLED_PRODUCT | EPR_CREDIT | GP_FEE | GRANT
  description  String
  amountINR    Decimal  @db.Decimal(12, 2)
  weightKg     Decimal? @db.Decimal(10, 3)
  referenceId  String?
  periodDate   DateTime
  recordedBy   String
  createdAt    DateTime @default(now())

  @@index([source])
  @@index([periodDate])
  @@map("revenue_entries")
}

// ─── Forward Linkage & PWD Marketplace ────────────────────────────────

model Product {
  id              String   @id @default(uuid())
  mrfId           String
  productType     String   // PAVER_BLOCK | FENCING_POST | ROOF_SHEET | ROAD_ADDITIVE
  name            String
  description     String?
  unitPriceINR    Decimal  @db.Decimal(10, 2)
  availableQty    Int      @default(0)
  unit            String   @default("UNITS")
  grade           String?
  photoUrl        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  saleLineItems   SaleLineItem[]

  @@map("products")
}

model SaleOrder {
  id              String   @id @default(uuid())
  orderCode       String   @unique
  buyerName       String
  buyerType       String   // GRAM_PANCHAYAT | PWD | CONTRACTOR | INDIVIDUAL | NGO
  buyerContact    String
  deliveryAddress String
  status          String   @default("PENDING") // PENDING | CONFIRMED | DISPATCHED | DELIVERED | CANCELLED
  totalAmountINR  Decimal  @db.Decimal(12, 2)
  paidAmountINR   Decimal  @db.Decimal(12, 2) @default(0)
  paymentStatus   String   @default("UNPAID") // UNPAID | PARTIAL | PAID
  deliveryDate    DateTime?
  notes           String?
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lineItems       SaleLineItem[]
  deliveryReceipt DeliveryReceipt?

  @@index([status])
  @@map("sale_orders")
}

model SaleLineItem {
  id              String   @id @default(uuid())
  saleOrderId     String
  saleOrder       SaleOrder @relation(fields: [saleOrderId], references: [id])
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  productionRunId String?
  productionRun   ProductionRun? @relation(fields: [productionRunId], references: [id])
  quantity        Int
  unitPriceINR    Decimal  @db.Decimal(10, 2)
  totalINR        Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  @@map("sale_line_items")
}

model DeliveryReceipt {
  id              String   @id @default(uuid())
  saleOrderId     String   @unique
  saleOrder       SaleOrder @relation(fields: [saleOrderId], references: [id])
  receivedBy      String
  receivedQty     Int
  condition       String   // GOOD | DAMAGED | PARTIAL
  evidenceUrl     String?
  notes           String?
  receivedAt      DateTime @default(now())

  @@map("delivery_receipts")
}

// ─── Low-Bandwidth Edge Sync ──────────────────────────────────────────

model EdgeSyncPayload {
  id                String   @id @default(uuid())
  deviceId          String
  payloadType       String   // BATCH | BIN_READING | CITIZEN_REPORT | PICKUP_REQUEST
  compressedSizeBytes Int?
  rawSizeBytes      Int?
  payload           Json
  status            String   @default("PENDING") // PENDING | PROCESSED | FAILED
  retryCount        Int      @default(0)
  lastError         String?
  signalStrengthDbm Int?
  networkType       String?  // 2G | 3G | 4G | WIFI | OFFLINE
  processedAt       DateTime?
  createdAt         DateTime @default(now())

  @@index([status])
  @@index([deviceId])
  @@map("edge_sync_payloads")
}

model OfflineSyncQueue {
  id                String   @id @default(uuid())
  clientDeviceId    String
  operationType     String   // CREATE_BATCH | UPDATE_BIN | REPORT_PICKUP | LOG_EXPENSE
  clientOperationId String   @unique
  payload           Json
  compressedPayload String?
  status            String   @default("QUEUED") // QUEUED | SYNCED | FAILED | DUPLICATE
  syncedAt          DateTime?
  errorMessage      String?
  networkType       String?
  createdAt         DateTime @default(now())

  @@index([status])
  @@index([clientDeviceId])
  @@map("offline_sync_queue")
}
