# =============================================================================
# GRAM-CIRCULAR (ECOZA) - Root Environment Configuration Example
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Backend API (apps/api/.env)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/gram_circular"
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
JWT_SECRET="gram-circular-dev-super-secret-key-32-bytes"

# -----------------------------------------------------------------------------
# 2. Frontend Web (apps/web/.env.local)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3001"

# -----------------------------------------------------------------------------
# 3. Map & Routing (OpenStreetMap & OSRM)
# -----------------------------------------------------------------------------
# NOTE: OpenStreetMap (OSM) and OSRM are 100% open-source and DO NOT require an API key!
# Map tiles and driving routes are fetched directly from free public community servers:
#
# - OSM Map Tiles: https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# - OSRM Routing:  https://router.project-osrm.org/route/v1/driving/...
#
# You only need to define these if you want to use custom/private self-hosted servers:
# NEXT_PUBLIC_OSM_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
# NEXT_PUBLIC_OSRM_ROUTING_URL="https://router.project-osrm.org"
